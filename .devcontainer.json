{
    "image": "mcr.microsoft.com/devcontainers/ruby:trixie",
    "features": {
	    "ghcr.io/devcontainers/features/ruby:2": { 
		    "versionManager": "rbenv" // Options: "none", "rbenv", or "rvm" 
		},
        "ghcr.io/devcontainers/features/docker-in-docker:4.1.1": {
            "version": "latest",
            "moby": false
        },
        "ghcr.io/devcontainers/features/node:2.1.0": {
            "version": "24"
        },
        "ghcr.io/devcontainers/features/copilot-cli:1": {}
    },
    "mounts": [
        "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,consistency=cached"
    ]
}